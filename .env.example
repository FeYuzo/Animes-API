# ==============================================================================
# Variáveis de Ambiente - AniTrack API & Gestão de Animes / Simulcast
# Copie este arquivo como .env e preencha com suas credenciais reais.
# NUNCA comite o arquivo .env no Git!
# ==============================================================================

# Porta do Servidor HTTP Público (Catálogo AniTrack)
PORT=3000

# URL interna do Microsserviço de Autenticação (dentro da rede Docker)
AUTH_SERVICE_URL=http://auth-service:4000

# URL interna do Microsserviço de Logs e Auditoria (dentro da rede Docker)
LOG_SERVICE_URL=http://log-service:5000

# Configurações do Redis (dentro da rede Docker)
REDIS_HOST=redis
REDIS_PORT=6379

# URL pública da aplicação (usada para montar o link do e-mail de recuperação de senha)
APP_URL=http://localhost:3000

# Credenciais da API do AniList (GraphQL & OAuth2 Client)
# Painel Developer: https://anilist.co/settings/developer
ANILIST_CLIENT_ID=56253
ANILIST_CLIENT_SECRET=kQSkVbWDjm4Zw5MZ7b1ZsNAHxpAeGaCH8yjElpxq

# Configurações de Conexão com o MariaDB
DB_HOST=mariadb
DB_PORT=3306
DB_USER=usuario_aluno
DB_PASSWORD=senha_aluno
DB_NAME=anitrack_db

# Segredo compartilhado para assinatura e validação dos tokens JWT
JWT_SECRET=seu_segredo_jwt_super_seguro_e_aleatorio

# ==============================================================================
# Configurações do Serviço de E-mail (SMTP)
# Dev: Mailtrap (sandbox.smtp.mailtrap.io | porta 2525)
# Prod: Brevo (smtp-relay.brevo.com | porta 587)
# ==============================================================================
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=seu_usuario_mailtrap
SMTP_PASS=sua_senha_mailtrap
SMTP_FROM="AniTrack <nao-responda@anitrack.com>"
 
# ==============================================================================
# Configurações do Object Storage (MinIO)
# ==============================================================================
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=perfil-usuarios
MINIO_PUBLIC_URL=http://localhost:9000

# ==============================================================================
# Configurações do Stripe (Pagamentos & Modo de Teste)
# ==============================================================================
STRIPE_SECRET_KEY=sk_test_sua_chave_secreta_aqui
STRIPE_PRICE_ID=price_id_do_produto_aqui
STRIPE_WEBHOOK_SECRET=whsec_seu_webhook_secret_aqui
